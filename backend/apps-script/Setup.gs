function configureProject(spreadsheetId,rootDriveFolderId,allowedOrigin){if(!spreadsheetId||!rootDriveFolderId)throw new Error('Укажите ID таблицы и ID корневой папки Drive.');PropertiesService.getScriptProperties().setProperties({SPREADSHEET_ID:String(spreadsheetId),ROOT_DRIVE_FOLDER_ID:String(rootDriveFolderId),ALLOWED_ORIGIN:String(allowedOrigin||'*')},false);return {configured:true};}
function setupProject(){var props=PropertiesService.getScriptProperties();var required=['SPREADSHEET_ID','ROOT_DRIVE_FOLDER_ID','APP_SECRET','ADMIN_PASSWORD_HASH'];var missing=required.filter(function(k){return !props.getProperty(k);});var database=setupDatabase();var folders=ensureSystemFolders();seedSettings();return {ok:missing.length===0,missing_properties:missing,database:database,folders:folders,next_step:missing.indexOf('ADMIN_PASSWORD_HASH')>=0?'Выполните setAdminPassword(\"ваш PIN\")':'Можно развертывать Web App'};}
function seedSettings(){var defaults=[['schema_version','1','Версия схемы данных'],['company_name','ТИТАН АВТО','Название компании'],['timezone','Europe/Samara','Часовой пояс'],['default_manager','Администратор','Менеджер по умолчанию']];var existing={};listRecords('SETTINGS').forEach(function(x){existing[x.key]=true;});defaults.forEach(function(x){if(!existing[x[0]])appendRecord('SETTINGS',{key:x[0],value:x[1],description:x[2],updated_at:nowIso()});});}
function createDemoData(){var session={user:'DEMO SETUP'};var car=vehicleCreate({brand:'Kia',model:'Rio',year:2017,mileage:145000,engine_volume:1.6,transmission:'AT',status:'in_work',seller_price:1150000,market_price:1090000,buyout_price:940000,sale_price:1070000,estimated_investments:35000,notes:'Демонстрационная запись'},session);var lead=leadCreate({brand:'LADA',model:'Vesta',year:2022,phone:'+7 900 000-00-00',seller_name:'Тестовый клиент',status:'new',notes:'Демонстрационная запись'},session);contactCreate({vehicle_id:car.vehicle_id,lead_id:lead.lead_id,type:'Звонок',result:'Перезвонить',next_action:'Уточнить решение',next_action_at:new Date(Date.now()+86400000).toISOString()},session);return {vehicle_id:car.vehicle_id,lead_id:lead.lead_id};}
