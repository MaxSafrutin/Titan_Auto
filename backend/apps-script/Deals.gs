function dealList(filters){var q=String((filters||{}).q||'');return sortNewest(listRecords('DEALS').map(dealHydrate).filter(function(x){return !q||containsQuery(x,q,['deal_id','number','type','status','seller_id','buyer_id','vehicle_id']);}));}
function dealHydrate(row){var extra=jsonParse(row.payload_json,{});var data=cleanObject(Object.assign({},extra,row));data.id=data.deal_id;data.data=jsonParse(data.data_json,data.data||{});return data;}
function dealCreate(payload,session){var timestamp=nowIso(),data=cleanObject(payload);data.deal_id=nextId('DEAL','DEAL');data.number=data.number||String(new Date().getFullYear())+'-'+data.deal_id.slice(-6);data.status=data.status||'draft';data.created_at=timestamp;data.updated_at=timestamp;data.data_json=JSON.stringify(data.data||{});data.selected_documents=JSON.stringify((data.data||{}).selectedDocuments||[]);data.terms_json=JSON.stringify((data.data||{}).terms||{});data.document_dates_json=JSON.stringify((data.data||{}).documentDates||{});data.payload_json=JSON.stringify(cleanObject(payload));appendRecord('DEALS',data);auditChanges(session,'DEAL',data.deal_id,'CREATE',{},data);return dealHydrate(data);}
function dealUpdate(id,changes,session){var before=findRecord('DEALS','deal_id',id);if(!before)throw apiError('DEAL_NOT_FOUND','Сделка не найдена.');var data=cleanObject(changes);delete data.id;delete data.deal_id;delete data.created_at;data.updated_at=nowIso();if(data.data){data.data_json=JSON.stringify(data.data);data.selected_documents=JSON.stringify(data.data.selectedDocuments||[]);data.terms_json=JSON.stringify(data.data.terms||{});data.document_dates_json=JSON.stringify(data.data.documentDates||{});}data.payload_json=JSON.stringify(Object.assign({},jsonParse(before.payload_json,{}),data));var after=updateRecord('DEALS','deal_id',id,data);auditChanges(session,'DEAL',id,'UPDATE',before,after);return dealHydrate(after);}
