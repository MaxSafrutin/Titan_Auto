function getContractTemplatesFolder(){var root=getRootFolder(),templates=getOrCreateFolder(root,'TEMPLATES');return getOrCreateFolder(templates,'CONTRACTS');}
function templateList(payload){var include=!!(payload||{}).include_content,files=getContractTemplatesFolder().getFiles(),rows=[];while(files.hasNext()){var file=files.next(),item={template_id:file.getId(),name:file.getName(),mime_type:file.getMimeType(),updated_at:file.getLastUpdated().toISOString()};if(include){var blob=file.getBlob();item.data_url='data:'+(blob.getContentType()||item.mime_type)+';base64,'+Utilities.base64Encode(blob.getBytes());}rows.push(item);}rows.sort(function(a,b){return a.name.localeCompare(b.name);});return rows;}
